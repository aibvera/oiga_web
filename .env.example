# Copia este archivo como .env (en esta misma carpeta) y rellénalo. El .env no se sube a git.
# Lo lee Django (backend/config/settings.py). El front tiene el suyo: frontend/.env.example.
# En Render estas variables se definen en el panel (ver render.yaml), no con este archivo.

# --- Django ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True en desarrollo. En producción False (o sin definir).
DJANGO_DEBUG=True

# --- Base de datos ---
# Dev: el Postgres de docker-compose.yml (docker compose up -d).
# Usa 127.0.0.1 y no "localhost": en Windows, localhost va por IPv6 y la conexión se cuelga.
DATABASE_URL=postgres://oiga:oiga@127.0.0.1:5432/oiga

# --- Solo producción (con DJANGO_DEBUG=True se ignoran o no hacen falta) ---
# Dominios extra de la API, separados por comas. En Render no hace falta: añade el suyo solo.
DJANGO_ALLOWED_HOSTS=
# URL del front (CORS + CSRF), p. ej. https://oiga.onrender.com. Varias separadas por comas.
FRONTEND_URL=

# --- Login con Google ---
# OAuth Client ID (Google Cloud Console > Credenciales). Vacío = botón desactivado.
# En producción, añade la URL del front a "Orígenes autorizados de JavaScript" de ese cliente.
GOOGLE_CLIENT_ID=
