# Vacío en desarrollo: las peticiones van a /api y Vite las redirige a Django (ver vite.config.js).
# Vacío también en Render: el front reenvía /api/* a la API (rewrite de render.yaml).
# Solo si el front llama directamente a la API en otro dominio: VITE_API_URL=https://api.midominio.com
# (y en el backend, FRONTEND_URL con la URL del front para CORS y CSRF).
VITE_API_URL=

# Botón "Continuar con Google": el mismo OAuth Client ID que GOOGLE_CLIENT_ID del backend.
# Vacío = no se muestra el botón. El valor real va en .env.local (no se sube a git).
VITE_GOOGLE_CLIENT_ID=
